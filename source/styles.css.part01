:root{
    --ink:#183153;
    --muted:#5d708a;
    --sky:#dff4ff;
    --blue:#2878d0;
    --teal:#12a594;
    --yellow:#ffd45b;
    --orange:#ff9f43;
    --red:#e85d75;
    --green:#39a96b;
    --paper:#ffffff;
    --bg:#f4fbff;
    --shadow:0 12px 30px rgba(24,49,83,.12);
    --radius:22px;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;font-family:"Noto Sans TC","PingFang TC","Microsoft JhengHei",sans-serif;background:linear-gradient(180deg,#dff4ff 0,#f7fcff 28%,#f5fbf6 100%);color:var(--ink)}
  button,input{font:inherit}
  button{cursor:pointer}
  .hero{position:relative;overflow:hidden;min-height:420px;padding:42px 20px 80px;background:linear-gradient(135deg,#48b8ef,#39c6a3)}
  .hero:after{content:"";position:absolute;left:-10%;right:-10%;bottom:-42px;height:110px;background:var(--bg);border-radius:50% 50% 0 0/100% 100% 0 0}
  .hero-inner{max-width:1100px;margin:auto;display:grid;grid-template-columns:1.15fr .85fr;gap:28px;align-items:center;position:relative;z-index:1}
  .badge{display:inline-flex;gap:8px;align-items:center;background:#fff7;padding:9px 14px;border:1px solid #fff9;border-radius:999px;font-weight:800}
  h1{font-size:clamp(38px,6vw,72px);line-height:1;margin:20px 0 14px;color:white;text-shadow:0 5px 0 #1778a655}
  .hero p{font-size:20px;line-height:1.8;color:#08385a;max-width:680px;font-weight:700}
  .hero-card{background:#ffffffdd;border:2px solid #fff;border-radius:28px;padding:20px;box-shadow:var(--shadow)}
  .city-illustration{display:grid;grid-template-columns:repeat(4,1fr);align-items:end;gap:8px;height:210px;padding:20px;background:linear-gradient(#bfeaff 0 55%,#b8e6b3 55% 72%,#8a8f98 72%);border-radius:20px;overflow:hidden}
  .building{border-radius:8px 8px 2px 2px;display:grid;grid-template-columns:repeat(2,1fr);gap:5px;padding:10px;background:#fff;box-shadow:0 8px 0 #0001}
  .building span{background:var(--yellow);border-radius:3px;height:12px}
  .building.b1{height:90px}.building.b2{height:145px;background:#ff9f8f}.building.b3{height:115px;background:#8ed0ff}.building.b4{height:165px;background:#b39cff}
  .road-icon{text-align:center;font-size:32px;margin-top:-8px}
  .topbar{position:sticky;top:0;z-index:10;background:#ffffffee;backdrop-filter:blur(8px);border-bottom:1px solid #dceaf3}
  .topbar-inner{max-width:1100px;margin:auto;padding:10px 18px;display:flex;gap:14px;align-items:center}
  .progress-wrap{flex:1;background:#e8f1f7;height:14px;border-radius:999px;overflow:hidden}
  .progress{height:100%;width:0;background:linear-gradient(90deg,var(--orange),var(--yellow),var(--teal));transition:.35s}
  .stars{font-weight:900;white-space:nowrap}
  main{max-width:1100px;margin:auto;padding:30px 18px 80px}
  .intro-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:18px}
  .mini-card,.panel{background:var(--paper);border-radius:var(--radius);box-shadow:var(--shadow)}
  .mini-card{padding:20px;border-top:7px solid var(--blue)}
  .mini-card:nth-child(2){border-color:var(--teal)}.mini-card:nth-child(3){border-color:var(--orange)}
  .mini-card h3{margin:5px 0 8px}.mini-card p{margin:0;color:var(--muted);line-height:1.7}
  .section-title{margin:50px 0 18px;display:flex;gap:12px;align-items:center;font-size:30px}
  .level{padding:26px;margin:22px 0;border:2px solid #e2eef6;position:relative;overflow:hidden}
  .level.locked{filter:grayscale(.45);opacity:.68}
  .level-tag{display:inline-flex;align-items:center;gap:8px;border-radius:999px;padding:8px 13px;background: