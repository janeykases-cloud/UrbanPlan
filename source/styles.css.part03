px;text-align:center;border:2px solid #dfeaf0}.score-chip b{font-size:20px;display:block}
  .quiz-question{margin:16px 0;padding:18px;background:#f8fbfd;border-radius:16px;border:1px solid #dce9f0}
  .quiz-question h3{margin-top:0;font-size:18px}.quiz-question label{display:block;margin:8px 0;padding:10px;background:white;border-radius:10px}
  .certificate-zone{text-align:center;padding:30px}
  .certificate-zone input{padding:12px 15px;border:2px solid #bfd3df;border-radius:12px;min-width:260px;margin:8px}
  canvas{max-width:100%;border-radius:16px;border:2px solid #e0c66c;background:white;margin-top:16px}
  .cert-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:12px}
  .toast{position:fixed;right:18px;bottom:18px;background:#17385c;color:white;padding:14px 18px;border-radius:14px;box-shadow:var(--shadow);transform:translateY(140%);transition:.35s;z-index:20;max-width:320px}
  .toast.show{transform:translateY(0)}
  .celebrate{animation:pop .5s ease}
  @keyframes pop{50%{transform:scale(1.03)}}
  .confetti{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:50}.confetti i{position:absolute;top:-20px;width:10px;height:16px;animation:fall 1.7s linear forwards}
  @keyframes fall{to{transform:translateY(110vh) rotate(720deg)}}
  footer{text-align:center;color:var(--muted);padding:30px}
  @media(max-width:820px){.hero-inner,.scenario,.budget-box,.builder{grid-template-columns:1fr}.hero-card{display:none}.intro-grid,.sort-grid,.smart-grid{grid-template-columns:1fr}.projects{grid-template-columns:1fr}.budget-meter{position:static}.scoreboard{grid-template-columns:repeat(2,1fr)}.city-canvas{grid-template-rows:repeat(5,60px)}.tool-buttons{grid-template-columns:repeat(3,1fr)}}
  @media print{body *{visibility:hidden}.certificate-zone,.certificate-zone *{visibility:visible}.certificate-zone{position:absolute;inset:0}.cert-actions,input,.certificate-zone>h2,.certificate-zone>p{display:none}canvas{border:0;width:100%}}
